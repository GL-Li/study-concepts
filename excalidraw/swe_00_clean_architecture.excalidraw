      "boundElements": null,
      "updated": 1794138458050,
      "link": null,
      "locked": false,
      "text": "Dependency rule:\n- inner layers must not depend on outer layer\n- as a result, we can write tests for inner layer without concrete outlayer implementation\n\nThe details of layers may vary but the independency rules must hold.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dependency rule:\n- inner layers must not depend on outer layer\n- as a result, we can write tests for inner layer without concrete outlayer implementation\n\nThe details of layers may vary but the independency rules must hold.",
      "autoResize": true,
      "lineHeight": 1.25
    }
